@model Product
@{
    ViewBag.Title = $"{ViewBag.Operation} Menu Item";
}
<style>
    .form-card { max-width: 960px; margin: 24px auto; }
    .card-header h3 { margin: 0; }
    .required::after { content: " *"; color: #d9534f; }
    .file-input { padding-top: 6px; }
</style>

<div class="container form-card">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3>@ViewBag.Operation Menu Item</h3>
        </div>
        <div class="card-body">
            <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="ProductId" />
                <input type="hidden" asp-for="CategoryId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label required"></label>
                            <input asp-for="Name" class="form-control" />
                            <div class="text-danger small" asp-validation-for="Name"></div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <div class="text-danger small" asp-validation-for="Description"></div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label"></label>
                                <input asp-for="Price" class="form-control" />
                                <div class="text-danger small" asp-validation-for="Price"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Stock" class="form-label">Quantity In Stock</label>
                                <input asp-for="Stock" class="form-control" />
                                <div class="text-danger small" asp-validation-for="Stock"></div>
                            </div>
                        </div>

                        <div class="mb-3 file-input">
                            <label for="imageUpload" class="form-label">Upload Image</label>
                            <input type="file" class="form-control" id="imageUpload" name="ImageFile" asp-for="ImageFile" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <div class="border rounded p-3">
                                @foreach(Category category in ViewBag.Categories)
                                {
                                    <div class="form-check">
                                        @{
                                            bool isChecked = Model.CategoryId == category.CategoryId;
                                        }
                                        <input type="radio" class="form-check-input" id="cat-@category.CategoryId" name="catId" value="@category.CategoryId" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label ms-2" for="cat-@category.CategoryId">@category.Name</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ingredients</label>
                            <div class="border rounded p-3" style="max-height:220px; overflow:auto;">
                                @foreach(Ingredient ingredient in ViewBag.Ingredients)
                                {
                                    <div class="form-check">
                                        @{
                                            bool isChecked = Model.ProductIngredients != null && Model.ProductIngredients.Any(i => i.IngredientId == ingredient.IngredientId);
                                        }
                                        <input type="checkbox" class="form-check-input" id="ing-@ingredient.IngredientId" name="ingredientIds" value="@ingredient.IngredientId" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label ms-2" for="ing-@ingredient.IngredientId">@ingredient.Name</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success">Save</button>
                    <a asp-action="Index" asp-controller="Product" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
