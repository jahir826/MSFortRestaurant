@model OrderViewModel

<style>
    .cart-card { max-width: 1100px; margin: 20px auto; }
    .card-header h2 { margin: 0; }
    .table td, .table th { vertical-align: middle; }
</style>

<div class="container cart-card">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2>My Cart</h2>
        </div>
        <div class="card-body">
            <form asp-action="PlaceOrder" method="post">
                <h5 class="mb-3">Order Items</h5>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.OrderItems.Count; i++)
                            {
                                var item = Model.OrderItems[i];
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("C")</td>
                                    <td class="text-end">@( (item.Quantity * item.Price).ToString("C") )</td>
                                </tr>
                            }
                            <tr>
                                <td colspan="2"></td>
                                <td class="text-end fw-semibold">Grand Total</td>
                                <td class="bg-primary bg-gradient text-white fw-bold text-end">@Model.TotalAmount.ToString("C")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <a asp-action="Create" asp-controller="Order" class="btn btn-outline-secondary">Continue Shopping</a>
                    <input type="submit" value="Place Order" class="btn btn-success" />
                </div>
            </form>
        </div>
    </div>
</div>
