﻿
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MSFortRestaurant</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MSFortRestaurant.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <!-- Added: favicon for better realism -->
    <link rel="icon" type="image/png" href="~/images/favicon.png" />

    <!-- Added: Google Fonts to improve typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Added: small custom styles to enhance layout look and feel -->
    <style>
            :root {
                --accent: #ff7a18; /* warm orange */
                --accent-2: #ffb199; /* light peach */
                --primary-dark: #0d3b66;
                --muted: #6c757d;
            }

            body {
                font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
                background: linear-gradient(180deg,#fdfbfb, #f1f6f9);
            }

            .hero-banner {
                background-image: linear-gradient(90deg, rgba(0,0,0,0.35), rgba(0,0,0,0.2)), url('/images/restaurant-hero.jpg');
                background-size: cover;
                background-position: center;
                color: white;
                padding: 4rem 0;
            }

                .hero-banner .lead {
                    font-size: 1.15rem;
                    opacity: 0.95;
                }

            .navbar-brand-enhanced {
                display: flex;
                align-items: center;
                gap: .5rem;
                font-weight: 700;
                color: var(--primary-dark);
            }

                .navbar-brand-enhanced img {
                    height: 34px;
                    width: 34px;
                    object-fit: cover;
                    border-radius: 6px;
                }

            .footer-dark {
                background: linear-gradient(90deg,#0b2447,#163f6f);
                color: rgba(255,255,255,0.95);
                padding: 2rem 0;
            }

            .toast-container {
                position: fixed;
                top: 1rem;
                right: 1rem;
                z-index: 1080;
            }

            /* Accent buttons */
            .btn-accent {
                background: linear-gradient(90deg,var(--accent),var(--accent-2));
                border: none;
                color: #fff;
                box-shadow: 0 6px 18px rgba(255,122,24,0.18);
            }

            .btn-accent-outline {
                background: rgba(255,122,24,0.06);
                border: 1px solid rgba(255,122,24,0.2);
                color: var(--accent);
            }

            /* Make carousel captions pop with colorful accent underline */
            .carousel-caption-bg {
                background: linear-gradient(180deg, rgba(0,0,0,0.5), rgba(0,0,0,0.35));
                display: inline-block;
                padding: .85rem 1rem;
                border-radius: .5rem;
                text-align: left;
                border-left: 4px solid var(--accent);
            }

            /* Fallback styling for placeholders */
            img.placeholder {
                filter: saturate(0.95) contrast(0.95);
                background: #f8f9fa;
            }

            /* Social buttons colorful */
            .btn-social {
                color: #fff;
                border: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                border-radius: 6px;
            }

            .btn-facebook {
                background: linear-gradient(90deg,#3b5998,#5b8bd6);
            }

            .btn-instagram {
                background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
            }

            .btn-twitter {
                background: linear-gradient(90deg,#1da1f2,#2aa7f6);
            }
    </style>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
      
                <a class="navbar-brand navbar-brand-enhanced" asp-area="" asp-controller="Home" asp-action="Index">
                    <!-- Place your high-resolution logo at wwwroot/images/msfort-logo.png -->
                    <img src="/Images/logo.jpg" alt="MSFort" loading="lazy" width="34" height="34"
                         onerror="this.onerror=null;this.src='/images/msfort-logo-placeholder.svg';this.classList.add('placeholder');" />
                    <span>MSFortRestaurant</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Ingredient" asp-action="Index"><i class="bi bi-leaf-fill"></i> Ingredients</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Product" asp-action="Index"><i class="bi bi-journal-food"></i> Menu Items</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Order" asp-action="Create"><i class="bi bi-cart-plus-fill"></i> Create Order</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>

        <section class="mb-4">
            <div id="restaurantCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#restaurantCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#restaurantCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#restaurantCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?auto=format&fit=crop&w=1600&q=80" loading="lazy" class="d-block w-100" alt="Cozy dining area" onerror="this.onerror=null;this.src='https://via.placeholder.com/1600x900.png?text=Image+Unavailable';this.classList.add('placeholder');">
                        <div class="carousel-caption d-none d-md-block">
                            <div class="carousel-caption-bg">
                                <h3>Cozy Ambience</h3>
                                <p>Enjoy a warm and welcoming dining space curated for comfort and style.</p>
                                <a class="btn btn-sm btn-accent" asp-area="" asp-controller="Home" asp-action="Index">Reserve a Table</a>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1600&q=80" loading="lazy" class="d-block w-100" alt="Gourmet dish" onerror="this.onerror=null;this.src='https://via.placeholder.com/1600x900.png?text=Image+Unavailable';this.classList.add('placeholder');">
                        <div class="carousel-caption d-none d-md-block">
                            <div class="carousel-caption-bg">
                                <h3>Chef's Specials</h3>
                                <p>Seasonal dishes crafted with fresh, locally sourced ingredients.</p>
                                <a class="btn btn-sm btn-accent" asp-area="" asp-controller="Product" asp-action="Index">Explore Menu</a>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="https://images.unsplash.com/photo-1551782450-a2132b4ba21d?auto=format&fit=crop&w=1600&q=80" loading="lazy" class="d-block w-100" alt="Chef preparing food" onerror="this.onerror=null;this.src='https://via.placeholder.com/1600x900.png?text=Image+Unavailable';this.classList.add('placeholder');">
                        <div class="carousel-caption d-none d-md-block">
                            <div class="carousel-caption-bg">
                                <h3>Passionate Craftsmanship</h3>
                                <p>Our team prepares every plate with care and creativity.</p>
                                <a class="btn btn-sm btn-accent" asp-area="" asp-controller="Order" asp-action="Create">Order Online</a>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#restaurantCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#restaurantCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </section>
    </header>
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Added: toast container for realtime notifications (SignalR messages, order updates) -->
    <div class="toast-container" id="realtimeToasts" aria-live="polite" aria-atomic="true"></div>

    <!-- Added: darker extended footer with contact and socials -->
    <footer class="footer-dark">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div>
                <strong>MSFortRestaurant</strong>
                <div class="small">123 Main Street, Springfield · (555) 555-0123 · hello@msfort.example</div>
            </div>
            <div class="mt-3 mt-md-0">
                <a class="btn btn-social btn-facebook btn-sm me-2" href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                <a class="btn btn-social btn-instagram btn-sm me-2" href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                <a class="btn btn-social btn-twitter btn-sm" href="#" aria-label="Twitter"><i class="bi bi-twitter"></i></a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js" integrity="" crossorigin="anonymous"></script>

    <script>
            (function() {
              
                try {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl('/hubs/notifications')
                        .withAutomaticReconnect()
                        .build();

                    connection.on('ReceiveNotification', function(title, message) {
                        showToast(title || 'Notification', message || 'You have an update.');
                    });

                    connection.start().catch(function(err) {
                        console && console.error('SignalR connection error:', err.toString());
                    });
                } catch (e) {
                    console && console.debug('SignalR not available', e);
                }

                function showToast(title, body) {
                    const container = document.getElementById('realtimeToasts');
                    if (!container) return;
                    const toastEl = document.createElement('div');
                    toastEl.className = 'toast align-items-center text-bg-light border-0 mb-2';
                    toastEl.setAttribute('role', 'alert');
                    toastEl.setAttribute('aria-live', 'assertive');
                    toastEl.setAttribute('aria-atomic', 'true');
                    toastEl.innerHTML = `
                                <div class="d-flex">
                                    <div class="toast-body">
                                        <strong>${escapeHtml(title)}</strong><div>${escapeHtml(body)}</div>
                                    </div>
                                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                                </div>`;
                    container.appendChild(toastEl);
                    const toast = new bootstrap.Toast(toastEl, { delay: 8000 });
                    toast.show();
                }

                function escapeHtml(unsafe) {
                    return unsafe
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#039;');
                }
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>